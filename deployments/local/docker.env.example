# docker.env.example — salin menjadi docker.env lalu isi nilai sebenarnya.
# Semua kredensial di bawah placeholder; JANGAN commit docker.env asli.

APP_ENV=docker

DB_HOST=pgbouncer
DB_HOST_MIGRATE=postgres
DB_PORT=5432
DB_USER=DRAGON
DB_PASS=DRAGON
DB_NAME=POINT_OF_SALE

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ── Redis (cluster 6 node) ──────────────────────────────────────────────
REDIS_HOST=redis-node-1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_CLUSTER_ENABLED=true
REDIS_CLUSTER_ENDPOINTS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379

REDIS_HOST_APIGATEWAY=redis-node-1
REDIS_PORT_APIGATEWAY=6379
REDIS_PASSWORD_APIGATEWAY=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_APIGATEWAY=0

REDIS_HOST_AUTH=redis-node-1
REDIS_PORT_AUTH=6379
REDIS_PASSWORD_AUTH=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_AUTH=1

REDIS_HOST_ROLE=redis-node-1
REDIS_PORT_ROLE=6379
REDIS_PASSWORD_ROLE=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_ROLE=2

REDIS_HOST_MERCHANT=redis-node-1
REDIS_PORT_MERCHANT=6379
REDIS_PASSWORD_MERCHANT=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_MERCHANT=3

REDIS_HOST_TRANSACTION=redis-node-1
REDIS_PORT_TRANSACTION=6379
REDIS_PASSWORD_TRANSACTION=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_TRANSACTION=4

REDIS_HOST_CASHIER=redis-node-1
REDIS_PORT_CASHIER=6379
REDIS_PASSWORD_CASHIER=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_CASHIER=5

REDIS_HOST_CATEGORY=redis-node-1
REDIS_PORT_CATEGORY=6379
REDIS_PASSWORD_CATEGORY=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_CATEGORY=6

REDIS_HOST_PRODUCT=redis-node-1
REDIS_PORT_PRODUCT=6379
REDIS_PASSWORD_PRODUCT=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_PRODUCT=7

REDIS_HOST_ORDER=redis-node-1
REDIS_PORT_ORDER=6379
REDIS_PASSWORD_ORDER=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_ORDER=8

REDIS_HOST_ORDERITEM=redis-node-1
REDIS_PORT_ORDERITEM=6379
REDIS_PASSWORD_ORDERITEM=CHANGE_ME_REDIS_PASSWORD
REDIS_DB_ORDERITEM=9

# ── Kafka (Fase 14 — K-6, K-7) ──────────────────────────────────────────
# Dev lokal: listener PLAINTEXT (docker-compose.yml). Produksi: SASL_SSL.
KAFKA_BROKERS=kafka:9092
KAFKA_ACKS=all
KAFKA_IDEMPOTENCE=true
# Aktifkan hanya jika broker memakai SASL/SCRAM + TLS (produksi):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="CHANGE_ME" password="CHANGE_ME";
# KAFKA_SSL_TRUSTSTORE_LOCATION=/certs/kafka.truststore.jks
# KAFKA_SSL_TRUSTSTORE_PASSWORD=CHANGE_ME
# KAFKA_SSL_TRUSTSTORE_TYPE=JKS

DB_SEEDER=false
SECRET_KEY=CHANGE_ME_SECRET_KEY
DB_URL=postgres://DRAGON:CHANGE_ME_DB_PASSWORD@postgres:5432/POINT_OF_SALE
APP_LOGGER=production
OTEL_ENDPOINT=otel-collector:4317

GRPC_USER_PORT=9011
GRPC_AUTH_PORT=9012
GRPC_ROLE_PORT=9006
GRPC_MERCHANT_PORT=9005
GRPC_TRANSACTION_PORT=9009
GRPC_CASHIER_PORT=9014
GRPC_CATEGORY_PORT=9015
GRPC_PRODUCT_PORT=9003
GRPC_ORDER_PORT=9001
GRPC_ORDER_ITEM_PORT=9016

SMTP_SERVER=CHANGE_ME_SMTP_SERVER
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
