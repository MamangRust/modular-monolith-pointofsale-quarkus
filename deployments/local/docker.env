DB_SEEDER=false
SECRET_KEY=yantopedia
DB_URL=postgres://DRAGON:DRAGON@postgres:5432/POINT_OF_SALE
KAFKA_BROKERS=kafka:9092
# Fase 14 (K-6, K-7): durability producer — acks=all + enable.idempotence=true.
KAFKA_ACKS=all
KAFKA_IDEMPOTENCE=true
# Dev lokal memakai listener PLAINTEXT (lihat docker-compose.yml). Untuk
# produksi (k8s SASL_SSL) tambahkan: KAFKA_SECURITY_PROTOCOL, KAFKA_SASL_JAAS_CONFIG,
# KAFKA_SSL_TRUSTSTORE_LOCATION, KAFKA_SSL_TRUSTSTORE_PASSWORD.
APP_LOGGER=production
OTEL_ENDPOINT=otel-collector:4317

GRPC_USER_ADDR=user:9011
GRPC_AUTH_ADDR=auth:9012
GRPC_ROLE_ADDR=role:9006
GRPC_MERCHANT_ADDR=merchant:9005
GRPC_TRANSACTION_ADDR=transaction:9009
GRPC_CASHIER_ADDR=cashier:9014
GRPC_CATEGORY_ADDR=category:9015
GRPC_PRODUCT_ADDR=product:9003
GRPC_ORDER_ADDR=order:9001
GRPC_ORDER_ITEM_ADDR=order_item:9016

GRPC_USER_PORT=9011
GRPC_AUTH_PORT=9012
GRPC_ROLE_PORT=9006
GRPC_MERCHANT_PORT=9005
GRPC_TRANSACTION_PORT=9009
GRPC_CASHIER_PORT=9014
GRPC_CATEGORY_PORT=9015
GRPC_PRODUCT_PORT=9003
GRPC_ORDER_PORT=9001
GRPC_ORDER_ITEM_PORT=9016

